# Copy to .env and fill in what you use. Nothing here is required to run the site.

# Public URL of the deployed site (no trailing slash). Makes social-preview image URLs absolute.
# Example: https://sailaja-portfolio.vercel.app
VITE_SITE_URL=

# Contact form, option A: Web3Forms (https://web3forms.com). Paste your access key.
VITE_WEB3FORMS_KEY=

# Contact form, option B: any JSON form endpoint, for example Formspree (https://formspree.io).
# Example: https://formspree.io/f/xxxxxxxx
VITE_FORM_ENDPOINT=
